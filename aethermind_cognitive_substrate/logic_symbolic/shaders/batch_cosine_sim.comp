#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in; // Wave64 optimal for AMD Polaris RX 580

layout(std430, binding = 0) readonly buffer QueryFloatBuffer {
    float query_vec[];
};

layout(std430, binding = 1) readonly buffer CandidateFloatBuffer {
    float candidate_vecs[];
};

layout(std430, binding = 2) writeonly buffer OutputCosineDistances {
    float cosine_distances[];
};

layout(push_constant) uniform PushConstants {
    uint num_candidates;
    uint dim;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_candidates) return;

    uint base = idx * pc.dim;
    float dot_val = 0.0;
    for (uint i = 0u; i < pc.dim; ++i) {
        dot_val += query_vec[i] * candidate_vecs[base + i];
    }
    cosine_distances[idx] = max(0.0, 1.0 - dot_val);
}
